/*
====================================================
PROJECT: SQL Learning Portfolio
TOPIC: Operators - Comparison Operators
SCENARIO: Equals To (=)
====================================================

BUSINESS REQUIREMENT:
The Sales Manager wants to identify
all products belonging to the Electronics category.
*/

SELECT
    SALE_ID,
    PRODUCT_NAME,
    CATEGORY,
    SALES_AMOUNT
FROM SALES_COMPARISON
WHERE CATEGORY = 'Electronics';
