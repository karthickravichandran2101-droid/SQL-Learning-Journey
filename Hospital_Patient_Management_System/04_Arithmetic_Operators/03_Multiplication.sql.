
/*
===========================================================
BUSINESS SCENARIO 01:
CALCULATE TOTAL MEDICINE INVENTORY VALUE

BUSINESS REQUIREMENT:
The Pharmacy Manager wants to calculate the total
inventory value of each medicine available in stock.

BUSINESS FORMULA:
Stock Quantity * Unit Price = Stock Value

===========================================================
*/

SELECT
    Medicine_ID,
    Medicine_Name,
    Category,
    Unit_Price,
    Stock_Quantity,

    Unit_Price * Stock_Quantity AS Total_Stock_Value

FROM dbo.Medicine;

/*
===========================================================
BUSINESS SCENARIO 02:
CALCULATE ESTIMATED MEDICINE PURCHASE COST

BUSINESS REQUIREMENT:
Calculate the purchase cost for 50 additional units
of each medicine.

BUSINESS FORMULA:
Unit Price * Purchase Quantity = Purchase Cost

===========================================================
*/

SELECT
    Medicine_ID,
    Medicine_Name,
    Unit_Price,

    50 AS Purchase_Quantity,

    Unit_Price * 50 AS Estimated_Purchase_Cost

FROM dbo.Medicine;


/*
===========================================================
BUSINESS SCENARIO 03:
CALCULATE MEDICINE INVENTORY VALUE

BUSINESS REQUIREMENT:
Calculate the total stock value of each medicine.

===========================================================
*/

SELECT
    Medicine_ID,
    Medicine_Name,
    Category,
    Unit_Price,
    Stock_Quantity,

    Unit_Price * Stock_Quantity AS Total_Stock_Value

FROM dbo.Medicine;

