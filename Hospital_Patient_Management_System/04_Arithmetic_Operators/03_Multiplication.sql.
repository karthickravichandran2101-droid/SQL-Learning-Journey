
/*
===========================================================
BUSINESS SCENARIO 01:
CALCULATE TOTAL MEDICINE INVENTORY VALUE

BUSINESS REQUIREMENT:
The Pharmacy Manager wants to calculate the total
inventory value of each medicine available in stock.

BUSINESS FORMULA:
Stock Quantity * Unit Price = Stock Value

===========================================================
*/

SELECT
    Medicine_ID,
    Medicine_Name,
    Category,
    Unit_Price,
    Stock_Quantity,

    Unit_Price * Stock_Quantity AS Total_Stock_Value

FROM dbo.Medicine;
